# Copy to packages/db/.env (for prisma CLI) and apps/web/.env + apps/worker/.env

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dentalos_dev"

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# S3-compatible storage (MinIO in dev — see docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="dentalos"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Meta platform (WhatsApp / Instagram / Facebook)
META_APP_ID=""
META_APP_SECRET=""            # enables webhook signature verification
META_WEBHOOK_VERIFY_TOKEN=""  # webhook GET verification handshake
META_TOKEN_KEY=""             # encrypts channel access tokens (falls back to AUTH_SECRET)
