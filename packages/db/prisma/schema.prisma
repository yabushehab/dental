// Tenancy core (Phase 0). Clinical / scheduling / billing / CRM models are
// added in their phases — see docs/DATA_MODEL.md for the full design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  country          String     @default("BH")
  currency         String     @default("BHD")
  /// minor units: 10^exponent per major unit (BHD = 3)
  currencyExponent Int        @default(3)
  timezone         String     @default("Asia/Bahrain")
  /// percent, e.g. 10.00 — per-procedure rates override this
  defaultVatRate   Decimal    @default(10.00) @db.Decimal(5, 2)
  plan             Plan       @default(TRIAL)
  planStatus       PlanStatus @default(ACTIVE)
  trialEndsAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  clinics     Clinic[]
  memberships Membership[]
  providers   Provider[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

model Clinic {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  email          String?
  /// weekly template: { "mon": [{"start":"09:00","end":"17:00"}], ... }
  workingHours   Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("clinics")
}

// ---------------------------------------------------------------------------
// Identity & staff
// ---------------------------------------------------------------------------

/// Global identity — NOT tenant-scoped. A user can belong to several
/// organizations via Membership.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  /// restrict to specific branches; empty = all branches
  clinicIds      String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  provider     Provider?

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Clinical practitioner profile for memberships with a clinical role.
model Provider {
  id                     String    @id @default(cuid())
  membershipId           String    @unique
  organizationId         String
  title                  String?
  specialty              String?
  nhraLicenseNo          String?
  licenseExpiry          DateTime?
  color                  String    @default("#2563eb")
  defaultAppointmentMins Int       @default(30)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  membership   Membership   @relation(fields: [membershipId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("providers")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  at             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, at])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  DENTIST
  HYGIENIST
  ASSISTANT
  RECEPTIONIST
  ACCOUNTANT
}

enum Plan {
  TRIAL
  STARTER
  PRO
}

enum PlanStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}
