// Tenancy core (Phase 0). Clinical / scheduling / billing / CRM models are
// added in their phases — see docs/DATA_MODEL.md for the full design.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; the debian target matches the node:22-slim
  // container images used in deployment.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  country          String     @default("BH")
  currency         String     @default("BHD")
  /// minor units: 10^exponent per major unit (BHD = 3)
  currencyExponent Int        @default(3)
  timezone         String     @default("Asia/Bahrain")
  /// percent, e.g. 10.00 — per-procedure rates override this
  defaultVatRate   Decimal    @default(10.00) @db.Decimal(5, 2)
  plan             Plan       @default(TRIAL)
  planStatus       PlanStatus @default(ACTIVE)
  trialEndsAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  clinics          Clinic[]
  memberships      Membership[]
  providers        Provider[]
  auditEvents      AuditEvent[]
  patients         Patient[]
  medicalHistories MedicalHistory[]
  documents        Document[]
  chairs           Chair[]
  appointmentTypes AppointmentType[]
  appointments     Appointment[]
  counters         Counter[]
  toothRecords     ToothRecord[]
  chartEntries     ChartEntry[]
  procedureCodes   ProcedureCode[]
  treatmentPlans   TreatmentPlan[]
  planItems        TreatmentPlanItem[]
  clinicalNotes    ClinicalNote[]
  noteAmendments   NoteAmendment[]
  prescriptions    Prescription[]
  invoices         Invoice[]
  invoiceLines     InvoiceLine[]
  payments         Payment[]
  insuranceCompanies InsuranceCompany[]
  insurancePolicies  InsurancePolicy[]
  insuranceClaims    InsuranceClaim[]
  channels           Channel[]
  contacts           Contact[]
  conversations      Conversation[]
  messages           Message[]
  messageTemplates   MessageTemplate[]
  campaigns          Campaign[]
  reminderRules      ReminderRule[]
  reminderLogs       ReminderLog[]

  @@map("organizations")
}

model Clinic {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  email          String?
  /// weekly template: { "mon": [{"start":"09:00","end":"17:00"}], ... }
  workingHours   Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  chairs       Chair[]
  appointments Appointment[]
  invoices     Invoice[]
  payments     Payment[]

  @@index([organizationId])
  @@map("clinics")
}

// ---------------------------------------------------------------------------
// Identity & staff
// ---------------------------------------------------------------------------

/// Global identity — NOT tenant-scoped. A user can belong to several
/// organizations via Membership.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  /// restrict to specific branches; empty = all branches
  clinicIds      String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  provider     Provider?

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Clinical practitioner profile for memberships with a clinical role.
model Provider {
  id                     String    @id @default(cuid())
  membershipId           String    @unique
  organizationId         String
  title                  String?
  specialty              String?
  nhraLicenseNo          String?
  licenseExpiry          DateTime?
  color                  String    @default("#2563eb")
  defaultAppointmentMins Int       @default(30)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  membership     Membership      @relation(fields: [membershipId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  appointments   Appointment[]
  chartEntries   ChartEntry[]
  treatmentPlans TreatmentPlan[]
  clinicalNotes  ClinicalNote[]
  prescriptions  Prescription[]

  @@index([organizationId])
  @@map("providers")
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

model Patient {
  id               String    @id @default(cuid())
  organizationId   String
  /// per-organization human-readable file number (see Counter)
  fileNumber       Int
  firstName        String
  lastName         String
  dob              DateTime? @db.Date
  sex              Sex?
  /// Bahrain CPR / national ID
  cpr              String?
  phone            String?
  email            String?
  address          String?
  emergencyContact Json?
  referralSource   String?
  primaryClinicId  String?
  whatsappOptIn    Boolean   @default(true)
  notes            String?
  tags             String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id])
  medicalHistories MedicalHistory[]
  documents        Document[]
  appointments     Appointment[]
  toothRecords     ToothRecord[]
  chartEntries     ChartEntry[]
  treatmentPlans   TreatmentPlan[]
  clinicalNotes    ClinicalNote[]
  prescriptions    Prescription[]
  invoices         Invoice[]
  payments         Payment[]
  insurancePolicies InsurancePolicy[]
  contacts         Contact[]

  @@unique([organizationId, fileNumber])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, phone])
  @@map("patients")
}

/// Versioned questionnaire — a new row is written on every update; the
/// latest row is the current history.
model MedicalHistory {
  id                String    @id @default(cuid())
  organizationId    String
  patientId         String
  /// structured questionnaire answers (allergies, conditions, medications…)
  answers           Json
  /// derived red-banner alerts, e.g. ["Penicillin allergy", "Diabetes"]
  alerts            String[]  @default([])
  completedByUserId String?
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@map("medical_histories")
}

model Document {
  id               String       @id @default(cuid())
  organizationId   String
  patientId        String?
  type             DocumentType @default(OTHER)
  s3Key            String
  fileName         String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?
  createdAt        DateTime     @default(now())
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model Chair {
  id             String   @id @default(cuid())
  organizationId String
  clinicId       String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]

  @@index([organizationId, clinicId])
  @@map("chairs")
}

model AppointmentType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  defaultMins    Int      @default(30)
  color          String   @default("#3b82f6")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  appointments Appointment[]

  @@index([organizationId])
  @@map("appointment_types")
}

model Appointment {
  id                 String            @id @default(cuid())
  organizationId     String
  clinicId           String
  patientId          String
  providerId         String
  chairId            String?
  typeId             String?
  /// UTC instants; rendered in the clinic's timezone
  startsAt           DateTime
  endsAt             DateTime
  status             AppointmentStatus @default(SCHEDULED)
  reason             String?
  cancellationReason String?
  notes              String?
  createdByUserId    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id])
  clinic        Clinic           @relation(fields: [clinicId], references: [id])
  patient       Patient          @relation(fields: [patientId], references: [id])
  provider      Provider         @relation(fields: [providerId], references: [id])
  chair         Chair?           @relation(fields: [chairId], references: [id])
  type          AppointmentType? @relation(fields: [typeId], references: [id])
  chartEntries  ChartEntry[]
  clinicalNotes ClinicalNote[]

  @@index([organizationId, clinicId, startsAt])
  @@index([organizationId, providerId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Clinical
// ---------------------------------------------------------------------------

/// Current state of one tooth (FDI). Absence of a row = PRESENT.
model ToothRecord {
  id             String      @id @default(cuid())
  organizationId String
  patientId      String
  toothFdi       Int
  status         ToothStatus @default(PRESENT)
  notes          String?
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@unique([patientId, toothFdi])
  @@index([organizationId])
  @@map("tooth_records")
}

/// One finding / planned procedure / completed procedure on a tooth
/// (or whole mouth when toothFdi is null). The chart is a projection of these.
model ChartEntry {
  id                  String         @id @default(cuid())
  organizationId      String
  patientId           String
  toothFdi            Int?
  /// subset of M O D B L I
  surfaces            String[]       @default([])
  kind                ChartEntryKind
  procedureCodeId     String?
  description         String
  providerId          String?
  appointmentId       String?
  treatmentPlanItemId String?
  enteredByUserId     String?
  createdAt           DateTime       @default(now())

  organization  Organization       @relation(fields: [organizationId], references: [id])
  patient       Patient            @relation(fields: [patientId], references: [id])
  procedureCode ProcedureCode?     @relation(fields: [procedureCodeId], references: [id])
  provider      Provider?          @relation(fields: [providerId], references: [id])
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id])
  planItem      TreatmentPlanItem? @relation(fields: [treatmentPlanItemId], references: [id])

  @@index([organizationId, patientId, createdAt])
  @@index([patientId, toothFdi])
  @@map("chart_entries")
}

/// Per-organization procedure catalog. Seeded with a standard dental set;
/// clinics edit prices. vatRate 0 = zero-rated healthcare (Bahrain);
/// cosmetic procedures carry the standard 10%.
model ProcedureCode {
  id               String            @id @default(cuid())
  organizationId   String
  code             String
  name             String
  category         ProcedureCategory
  defaultPriceFils Int               @default(0)
  vatRate          Decimal           @default(0.00) @db.Decimal(5, 2)
  defaultMins      Int?
  isPerTooth       Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  chartEntries ChartEntry[]
  planItems    TreatmentPlanItem[]
  invoiceLines InvoiceLine[]

  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@map("procedure_codes")
}

model TreatmentPlan {
  id             String              @id @default(cuid())
  organizationId String
  patientId      String
  providerId     String?
  title          String
  status         TreatmentPlanStatus @default(DRAFT)
  notes          String?
  presentedAt    DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  patient      Patient             @relation(fields: [patientId], references: [id])
  provider     Provider?           @relation(fields: [providerId], references: [id])
  items        TreatmentPlanItem[]

  @@index([organizationId, patientId])
  @@map("treatment_plans")
}

model TreatmentPlanItem {
  id              String         @id @default(cuid())
  organizationId  String
  planId          String
  procedureCodeId String
  toothFdi        Int?
  surfaces        String[]       @default([])
  /// phase number for sequencing treatment (1, 2, 3…)
  phase           Int            @default(1)
  priceFils       Int
  vatRate         Decimal        @default(0.00) @db.Decimal(5, 2)
  status          PlanItemStatus @default(PENDING)
  completedAt     DateTime?
  createdAt       DateTime       @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id])
  plan          TreatmentPlan @relation(fields: [planId], references: [id])
  procedureCode ProcedureCode @relation(fields: [procedureCodeId], references: [id])
  chartEntries  ChartEntry[]
  invoiceLines  InvoiceLine[]

  @@index([organizationId, planId])
  @@map("treatment_plan_items")
}

/// SOAP note — immutable once signed; corrections go through NoteAmendment.
model ClinicalNote {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  providerId     String
  appointmentId  String?
  subjective     String    @default("")
  objective      String    @default("")
  assessment     String    @default("")
  plan           String    @default("")
  signedAt       DateTime?
  signedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  patient      Patient         @relation(fields: [patientId], references: [id])
  provider     Provider        @relation(fields: [providerId], references: [id])
  appointment  Appointment?    @relation(fields: [appointmentId], references: [id])
  amendments   NoteAmendment[]

  @@index([organizationId, patientId, createdAt])
  @@map("clinical_notes")
}

model NoteAmendment {
  id             String   @id @default(cuid())
  organizationId String
  noteId         String
  text           String
  byUserId       String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  note         ClinicalNote @relation(fields: [noteId], references: [id])

  @@index([noteId])
  @@map("note_amendments")
}

model Prescription {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  providerId     String
  /// [{ drug, dose, frequency, duration }]
  items          Json
  notes          String?
  issuedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  provider     Provider     @relation(fields: [providerId], references: [id])

  @@index([organizationId, patientId, issuedAt])
  @@map("prescriptions")
}

// ---------------------------------------------------------------------------
// Billing — all amounts are integer minor units (fils for BHD)
// ---------------------------------------------------------------------------

model Invoice {
  id                   String        @id @default(cuid())
  organizationId       String
  clinicId             String
  patientId            String
  /// assigned at issue time: INV-YYYY-NNNNN (null while draft)
  number               String?
  status               InvoiceStatus @default(DRAFT)
  issuedAt             DateTime?
  dueAt                DateTime?
  subtotalFils         Int           @default(0)
  vatFils              Int           @default(0)
  totalFils            Int           @default(0)
  paidFils             Int           @default(0)
  insurancePortionFils Int           @default(0)
  notes                String?
  createdByUserId      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  clinic       Clinic           @relation(fields: [clinicId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]
  claims       InsuranceClaim[]

  @@unique([organizationId, number])
  @@index([organizationId, status, issuedAt])
  @@index([patientId, createdAt])
  @@map("invoices")
}

model InvoiceLine {
  id                  String  @id @default(cuid())
  organizationId      String
  invoiceId           String
  /// set when the line bills a treatment plan item — prevents double billing
  treatmentPlanItemId String? @unique
  procedureCodeId     String?
  description         String
  toothFdi            Int?
  qty                 Int     @default(1)
  unitPriceFils       Int
  vatRate             Decimal @default(0.00) @db.Decimal(5, 2)
  vatFils             Int     @default(0)
  totalFils           Int

  organization  Organization       @relation(fields: [organizationId], references: [id])
  invoice       Invoice            @relation(fields: [invoiceId], references: [id])
  planItem      TreatmentPlanItem? @relation(fields: [treatmentPlanItemId], references: [id])
  procedureCode ProcedureCode?     @relation(fields: [procedureCodeId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id               String        @id @default(cuid())
  organizationId   String
  clinicId         String
  patientId        String
  /// null = unallocated payment, sits as patient credit
  invoiceId        String?
  amountFils       Int
  method           PaymentMethod
  reference        String?
  /// RCP-YYYY-NNNNN
  receiptNumber    String
  receivedByUserId String?
  receivedAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  clinic       Clinic       @relation(fields: [clinicId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, receivedAt])
  @@index([patientId])
  @@map("payments")
}

model InsuranceCompany {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  policies     InsurancePolicy[]

  @@index([organizationId])
  @@map("insurance_companies")
}

model InsurancePolicy {
  id              String    @id @default(cuid())
  organizationId  String
  patientId       String
  companyId       String
  policyNumber    String
  memberId        String?
  /// default percentage the insurer covers, e.g. 80.00
  coveragePercent Decimal   @default(0.00) @db.Decimal(5, 2)
  annualLimitFils Int?
  expiresAt       DateTime?
  coverageNotes   String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  company      InsuranceCompany @relation(fields: [companyId], references: [id])
  claims       InsuranceClaim[]

  @@index([organizationId, patientId])
  @@map("insurance_policies")
}

/// Manual claim tracking (no insurer API in v1).
model InsuranceClaim {
  id              String      @id @default(cuid())
  organizationId  String
  invoiceId       String
  policyId        String
  claimedFils     Int
  status          ClaimStatus @default(PREPARING)
  submittedAt     DateTime?
  resolvedAt      DateTime?
  approvedFils    Int?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  invoice      Invoice         @relation(fields: [invoiceId], references: [id])
  policy       InsurancePolicy @relation(fields: [policyId], references: [id])

  @@index([organizationId, status])
  @@map("insurance_claims")
}

// ---------------------------------------------------------------------------
// CRM / omnichannel messaging
// ---------------------------------------------------------------------------

/// A connected platform account (WhatsApp number, Instagram business
/// account, Facebook page). No access token = simulated mode: outbound
/// messages are stored and marked SENT without calling Meta.
model Channel {
  id             String          @id @default(cuid())
  organizationId String
  platform       ChannelPlatform
  /// phone-number-id (WA) / IG business id / page id
  externalId     String
  displayName    String
  /// AES-256-GCM encrypted long-lived token (see @dentalos/meta)
  accessTokenEnc String?
  status         ChannelStatus   @default(CONNECTED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  conversations Conversation[]

  @@unique([platform, externalId])
  @@index([organizationId])
  @@map("channels")
}

/// A person on a platform (wa_id / IGSID / PSID), linkable to a Patient.
model Contact {
  id             String          @id @default(cuid())
  organizationId String
  platform       ChannelPlatform
  externalUserId String
  displayName    String?
  phone          String?
  patientId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  patient       Patient?       @relation(fields: [patientId], references: [id])
  conversations Conversation[]

  @@unique([organizationId, platform, externalUserId])
  @@map("contacts")
}

model Conversation {
  id               String             @id @default(cuid())
  organizationId   String
  channelId        String
  contactId        String
  status           ConversationStatus @default(OPEN)
  assignedToUserId String?
  lastMessageAt    DateTime           @default(now())
  /// drives the 24-hour free-form reply window
  lastInboundAt    DateTime?
  unreadCount      Int                @default(0)
  labels           String[]           @default([])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  channel      Channel      @relation(fields: [channelId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])
  messages     Message[]

  @@unique([channelId, contactId])
  @@index([organizationId, status, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String           @id @default(cuid())
  organizationId    String
  conversationId    String
  direction         MessageDirection
  externalMessageId String?          @unique
  type              MessageType      @default(TEXT)
  body              String?
  templateName      String?
  status            MessageStatus    @default(SENT)
  failReason        String?
  /// null for inbound and automated messages
  sentByUserId      String?
  at                DateTime         @default(now())
  raw               Json?

  organization Organization @relation(fields: [organizationId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, at])
  @@map("messages")
}

/// WhatsApp-approved templates and internal quick replies.
model MessageTemplate {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  platform       ChannelPlatform  @default(WHATSAPP)
  language       String           @default("en")
  /// body with {{1}}, {{2}} placeholders
  body           String
  metaTemplateId String?
  approvalStatus TemplateApproval @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  campaigns     Campaign[]
  reminderRules ReminderRule[]

  @@unique([organizationId, name, language])
  @@map("message_templates")
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  templateId     String
  /// filter: { tags?: string[], noVisitSinceDays?: number }
  segment        Json           @default("{}")
  scheduledAt    DateTime?
  status         CampaignStatus @default(DRAFT)
  /// { targeted, sent, skipped }
  stats          Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  template     MessageTemplate @relation(fields: [templateId], references: [id])

  @@index([organizationId, status])
  @@map("campaigns")
}

/// Raw inbound webhook deliveries — global (organization resolved during
/// processing), idempotent on the body hash, kept for replay.
model WebhookEvent {
  id              String    @id @default(cuid())
  platform        String
  /// sha256 of the raw body — dedupes Meta redeliveries
  externalEventId String    @unique
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  error           String?

  @@index([processedAt, receivedAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Automated reminders
// ---------------------------------------------------------------------------

model ReminderRule {
  id                   String   @id @default(cuid())
  organizationId       String
  /// send when appointment is within this many hours
  offsetHours          Int      @default(24)
  templateId           String?
  /// reply "confirm"/button moves the appointment to CONFIRMED
  requiresConfirmation Boolean  @default(true)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  logs         ReminderLog[]

  @@index([organizationId])
  @@map("reminder_rules")
}

model ReminderLog {
  id             String         @id @default(cuid())
  organizationId String
  appointmentId  String
  ruleId         String
  status         ReminderStatus @default(SENT)
  detail         String?
  sentAt         DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  rule         ReminderRule @relation(fields: [ruleId], references: [id])

  @@unique([appointmentId, ruleId])
  @@map("reminder_logs")
}

/// Per-organization named sequences (patient file numbers, invoice numbers…).
/// Incremented atomically via upsert.
model Counter {
  id             String @id @default(cuid())
  organizationId String
  key            String
  value          Int

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("counters")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  at             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, at])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

